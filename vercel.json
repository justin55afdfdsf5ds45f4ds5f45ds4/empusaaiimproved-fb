{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/panda", "destination": "/panda/index.html" },
    { "source": "/panda/", "destination": "/panda/index.html" },
    { "source": "/((?!panda/).*)", "destination": "/index.html" }
  ]
}
